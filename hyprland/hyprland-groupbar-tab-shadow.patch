+// Nightdrive: the tabs' shadows. The shadow shader fills its whole box and cuts out only the window, so the tab itself
+// is left out of the damage it draws in (all but its rounded corners' squares): a see-through tab isn't darkened. The
+// window stays cut out (currentWindow, set by getRenderData), so the shadow below the tabs doesn't darken it either.
+void CHyprDropShadowDecoration::drawTabShadows(Render::CRenderContext& ctx, PHLMONITOR pMonitor, float a, int range, const Render::SWindowRenderPresentation& presentation) {
+    if (m_tabShadows.empty())
+        return;
+
+    const auto    GRADIENT = m_gradient.renderState();
+    const CRegion DAMAGE   = ctx.m_data.damage;
+
+    for (const auto& TAB : m_tabShadows) {
+        const double R      = std::min<double>(TAB.rounding, std::min(TAB.tabBox.w, TAB.tabBox.h) / 2.0);
+        CRegion      inside = CRegion{CBox{TAB.tabBox.x + R, TAB.tabBox.y, TAB.tabBox.w - 2 * R, TAB.tabBox.h}};
+        inside.add(CBox{TAB.tabBox.x, TAB.tabBox.y + R, TAB.tabBox.w, TAB.tabBox.h - 2 * R});
+        ctx.m_data.renderModif.applyToRegion(inside);
+
+        ctx.m_data.damage = DAMAGE.copy().subtract(inside);
+        if (ctx.m_data.damage.empty())
+            continue;
+
+        if (GRADIENT.transitioning)
+            drawShadowInternal(ctx, TAB.shadowBox, TAB.rounding, TAB.roundingPower, range, GRADIENT.previous, GRADIENT.current, GRADIENT.progress, a, presentation);
+        else
+            drawShadowInternal(ctx, TAB.shadowBox, TAB.rounding, TAB.roundingPower, range, GRADIENT.current, a, presentation);
+    }
+
+    ctx.m_data.damage = DAMAGE;
+}
