+std::vector<CBox> CHyprGroupBarDecoration::tabBoxes(PHLMONITOR pMonitor, const Render::SWindowRenderPresentation& presentation) {
+    static auto       PRENDERTITLES    = CConfigValue<Config::INTEGER>("group:groupbar:render_titles");
+    static auto       PHEIGHT          = CConfigValue<Config::INTEGER>("group:groupbar:height");
+    static auto       PINDICATORGAP    = CConfigValue<Config::INTEGER>("group:groupbar:indicator_gap");
+    static auto       PINDICATORHEIGHT = CConfigValue<Config::INTEGER>("group:groupbar:indicator_height");
+    static auto       PGRADIENTS       = CConfigValue<Config::INTEGER>("group:groupbar:gradients");
+    static auto       PSTACKED         = CConfigValue<Config::INTEGER>("group:groupbar:stacked");
+    static auto       POUTERGAP        = CConfigValue<Config::INTEGER>("group:groupbar:gaps_out");
+    static auto       PINNERGAP        = CConfigValue<Config::INTEGER>("group:groupbar:gaps_in");
+
+    std::vector<CBox> boxes;
+    const int         BARS = m_dwGroupMembers.size();
+    // only what draw() fills casts a shadow: the gradient (the tab) and the indicator line, not the titles alone
+    if (BARS == 0 || !visible() || (!*PGRADIENTS && *PINDICATORHEIGHT <= 0))
+        return boxes;
+
+    const auto  ASSIGNEDBOX  = assignedBoxGlobal(presentation);
+    const auto  ONEBARHEIGHT = *POUTERGAP + *PINDICATORHEIGHT + *PINDICATORGAP + (*PGRADIENTS || *PRENDERTITLES ? *PHEIGHT : 0);
+    const float BARWIDTH     = *PSTACKED ? ASSIGNEDBOX.w : (ASSIGNEDBOX.w - *PINNERGAP * (BARS - 1)) / BARS;
+
+    float       xoff = 0;
+    float       yoff = 0;
+    for (int i = 0; i < BARS; ++i) {
+        // the same rects as draw(): the gradient's top, down to the indicator's bottom when there is one
+        const double BASEY  = ASSIGNEDBOX.y + ASSIGNEDBOX.h - std::floor(yoff) - pMonitor->m_position.y;
+        const double TOP    = *PGRADIENTS ? BASEY - ONEBARHEIGHT : BASEY - *PINDICATORHEIGHT - *POUTERGAP;
+        const double BOTTOM = *PINDICATORHEIGHT > 0 ? BASEY - *POUTERGAP : TOP + *PHEIGHT;
+        if (BOTTOM > TOP && BARWIDTH > 0)
+            boxes.emplace_back(ASSIGNEDBOX.x + xoff - pMonitor->m_position.x, TOP, BARWIDTH, BOTTOM - TOP);
+
+        if (*PSTACKED)
+            yoff += ONEBARHEIGHT;
+        else
+            xoff += *PINNERGAP + BARWIDTH;
+    }
+
+    return boxes;
+}
+
+int CHyprGroupBarDecoration::tabRounding() {
+    static auto PGRADIENTS        = CConfigValue<Config::INTEGER>("group:groupbar:gradients");
+    static auto PROUNDING         = CConfigValue<Config::INTEGER>("group:groupbar:rounding");
+    static auto PGRADIENTROUNDING = CConfigValue<Config::INTEGER>("group:groupbar:gradient_rounding");
+    return *PGRADIENTS ? *PGRADIENTROUNDING : *PROUNDING;
+}
+
+float CHyprGroupBarDecoration::tabRoundingPower() {
+    static auto PGRADIENTS             = CConfigValue<Config::INTEGER>("group:groupbar:gradients");
+    static auto PROUNDINGPOWER         = CConfigValue<Config::FLOAT>("group:groupbar:rounding_power");
+    static auto PGRADIENTROUNDINGPOWER = CConfigValue<Config::FLOAT>("group:groupbar:gradient_rounding_power");
+    return *PGRADIENTS ? *PGRADIENTROUNDINGPOWER : *PROUNDINGPOWER;
+}
